# ── Frontend (Vite) ────────────────────────────────────────────────
# Safe to expose in the browser. The Anthropic key NEVER goes here.
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── API server ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=8787
CLIENT_ORIGIN=http://localhost:5173

# Anthropic credential (server only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Only enable to exercise the UI without an Anthropic key.
# Never enable for a public production deployment.
AI_DEMO_MODE=false

# Rate limits (window minutes / max requests per IP)
CHAT_RATE_WINDOW_MINUTES=15
CHAT_RATE_MAX=30
ASSIST_RATE_WINDOW_MINUTES=15
ASSIST_RATE_MAX=60
WORD_RATE_WINDOW_MINUTES=15
WORD_RATE_MAX=150

# Set to "1" when the API runs behind a trusted reverse proxy.
TRUST_PROXY=0

# ── Frontend (Vite) ────────────────────────────────────────────────
# Safe to expose in the browser. AI provider keys NEVER go here.
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local development only. Lets the web app call AI routes when the API runs
# with AUTH_BYPASS_DEV=true and no Supabase project exists. Never enable this
# for a deployed build — Vite inlines it into the browser bundle.
VITE_AI_DEV_BYPASS=false

# ── API server ─────────────────────────────────────────────────────
# NODE_ENV is intentionally not set here: Vite reads this same file, so a
# NODE_ENV=development entry would downgrade production web builds. The API
# defaults to development; set NODE_ENV=production in the host environment.
PORT=8787
CLIENT_ORIGIN=http://localhost:5173

# ── AI provider ────────────────────────────────────────────────────
# anthropic | gemini | demo
# Leave unset to auto-select from the configured API keys (Anthropic first).
# AI_PROVIDER=anthropic

# Anthropic credential (server only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Google Gemini credential (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Only enable to exercise the UI without an AI key.
# Never enable for a public production deployment.
AI_DEMO_MODE=false

# ── AI access control (Phase 2) ────────────────────────────────────
# The API verifies Supabase access tokens with these public values. Leave
# blank to fall back to VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Closed beta: only profiles.approved = true may use AI. Learners redeem an
# invite code in the app; the code is created in the invite_codes table.
BETA_GATE=false
# Kill switch: "true" closes every AI route immediately (friendly 503).
AI_DISABLED=false
# Total AI calls allowed per UTC day across all learners. 0 disables it.
GLOBAL_DAILY_AI_CAP=0

# Per-user daily quotas (reset at 00:00 UTC).
AI_QUOTA_CHAT=40
AI_QUOTA_SCENARIO=5
AI_QUOTA_DRILL=10
AI_QUOTA_WORD=60
AI_QUOTA_ASSIST=60
AI_QUOTA_RECAP=5

# Provider timeout; keep below the serverless function limit.
PROVIDER_TIMEOUT_MS=25000
# How many chat turns are forwarded to the provider.
CHAT_HISTORY_TURNS=8

# Development only: accept AI routes without a Supabase session and skip
# database quotas. Ignored whenever NODE_ENV=production.
AUTH_BYPASS_DEV=false

# Rate limits (window minutes / max requests per IP)
CHAT_RATE_WINDOW_MINUTES=15
CHAT_RATE_MAX=30
ASSIST_RATE_WINDOW_MINUTES=15
ASSIST_RATE_MAX=60
WORD_RATE_WINDOW_MINUTES=15
WORD_RATE_MAX=150

# AI scenario generation (kept lower because each miss calls the provider)
SCENARIO_RATE_WINDOW_MINUTES=15
SCENARIO_RATE_MAX=20

# AI drill generation (one batch can trigger a replacement provider call)
DRILL_RATE_WINDOW_MINUTES=15
DRILL_RATE_MAX=20

# Set to "1" when the API runs behind a trusted reverse proxy.
TRUST_PROXY=0

# ── Shared rate limiting (optional) ────────────────────────────────
# Redis keeps per-IP rate-limit counters shared across API instances.
# Leave empty for the per-process in-memory store (fine for one instance).
REDIS_URL=
# memory | redis. Defaults to redis when REDIS_URL is set.
RATE_LIMIT_STORE=

# ── Observability ──────────────────────────────────────────────────
# JSON request logs are on by default outside tests. Set to "false" to
# silence per-request lines; /api/metrics stays available either way.
LOG_REQUESTS=true
